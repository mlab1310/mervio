# Exemple de configuration LOCALE. Copier en .env (ignore par Git) et adapter.
# Ne jamais mettre ici une valeur de production.

# --- docker-compose.yml (004.3.8) -------------------------------------------------------
# Quatre mots de passe distincts, 16 a 128 caracteres parmi [A-Za-z0-9._~-]
# (utilisables tels quels dans une URL). Exemple: openssl rand -hex 24
# Superutilisateur du conteneur postgres (bootstrap et tests seulement)
MERVIO_POSTGRES_PASSWORD=
# Roles crees par docker/postgres/10-mervio-bootstrap.sql a l'initialisation du volume
MERVIO_MIGRATOR_DB_PASSWORD=
MERVIO_APP_DB_PASSWORD=
MERVIO_WORKER_DB_PASSWORD=
# Cle maitre d'identite client du worker (004.4.2, D-053): 32 octets en hexadecimal, jamais en base,
# jamais journalisee. La perdre bloque les nouveaux imports (refus explicite). Exemple: openssl rand -hex 32
MERVIO_IDENTITY_MASTER_KEY=
# Facultatif: port publie sur 127.0.0.1 (defaut 55432), image utilisee (defaut mervio:local)
# MERVIO_POSTGRES_PORT=55432
# MERVIO_IMAGE=mervio:local

# --- Hors conteneur (processus Python locaux) --------------------------------------------
# Connexion d'administration du cluster local. Sert a creer les bases jetables
# des tests et a lancer les migrations en local. Jamais utilisee par le code applicatif.
# Docker:  postgresql://mervio_admin:<mot de passe>@127.0.0.1:55432/postgres
# Sans Docker (scripts/dev_postgres.sh): postgresql://mervio_admin@127.0.0.1:55432/postgres
MERVIO_ADMIN_DATABASE_URL=

# Migrations (role proprietaire du schema)
MERVIO_MIGRATION_DATABASE_URL=

# Application: role de connexion membre de mervio_app, sans superutilisateur ni BYPASSRLS
MERVIO_DATABASE_URL=
